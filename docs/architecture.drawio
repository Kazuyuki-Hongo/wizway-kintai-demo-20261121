        <mxCell id="tmp" value="&lt;b style=&quot;font-size:14px&quot;&gt;/tmp 作業コピー&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;attendance.db&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#545B64;strokeWidth=2;fontColor=#232F3E;align=center;verticalAlign=middle;" vertex="1" parent="1">
