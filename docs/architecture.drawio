        </mxCell>

        <mxCell id="note_bottom" value="&lt;font style=&quot;font-size:14px&quot;&gt;画面は CloudFront → S3。API は API Gateway（HTTP API）→ Lambda。データは同梱 SQLite をシードにし、更新は S3 の共有ファイルへ書き戻す。&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontColor=#545B64;" vertex="1" parent="1">
          <mxGeometry x="40" y="980" width="1200" height="36" as="geometry" />
        </mxCell>

