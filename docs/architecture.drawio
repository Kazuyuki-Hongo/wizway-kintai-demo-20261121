        <!-- 主な経路メモ -->
        <mxCell id="note_api" value="&lt;b style=&quot;font-size:14px&quot;&gt;主な経路&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;GET /employees&lt;br&gt;GET …/months/{ym}&lt;br&gt;PUT …/days/{date}&lt;br&gt;POST /login /logout&lt;br&gt;GET /months/{ym}/overview&lt;br&gt;GET /months/{ym}/export&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2;align=left;spacingLeft=12;spacingTop=8;fontColor=#232F3E;" vertex="1" parent="1">
